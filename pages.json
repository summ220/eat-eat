{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/welcome/welcome",
			"style": {
				"navigationBarTitleText": "干饭小家",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "吃什么",
				"navigationBarBackgroundColor": "#FFF5F7",
				"navigationBarTextStyle": "black",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/stock/stock",
			"style": {
				"navigationBarTitleText": "食材库存",
				"navigationBarBackgroundColor": "#FFF5F7",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/recipe/recipe",
			"style": {
				"navigationBarTitleText": "菜谱",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/recipe/component/detail",
			"style": {
				"navigationBarTitleText": "菜谱详情",
				"navigationBarBackgroundColor": "#FFE6E6"
			}
		},
		{
			"path": "pages/recipe/component/edit",
			"style": {
				"navigationBarTitleText": "添加菜谱",
				"navigationBarBackgroundColor": "#FFE6E6"
			}
		},
		{
			"path": "pages/shop/shop",
			"style": {
				"navigationBarTitleText": "购物清单",
				"navigationBarBackgroundColor": "#FFF5F7",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/family/family",
			"style": {
				"navigationBarTitleText": "家庭",
				"navigationBarBackgroundColor": "#FFF5F7",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/stock/component/addStock",
			"style": {
				"navigationBarTitleText": "添加食材",
				"navigationBarBackgroundColor": "#FFF5F7"
			}
		},
		{
			"path": "pages/shop/component/addShop",
			"style": {
				"navigationBarTitleText": "添加购物",
				"navigationBarBackgroundColor": "#FFF5F7"
			}
		},
		{
			"path": "pages/cost/cost",
			"style": {
				"navigationBarTitleText": "花费账本",
				"navigationBarBackgroundColor": "#FFF5F7"
			}
		},
		{
			"path": "pages/family/component/singlePage/memo",
			"style": {
				"navigationBarTitleText": "家庭备忘录",
				"navigationBarBackgroundColor": "#FFF5F7"
			}
		},
		{
			"path": "pages/family/component/singlePage/health",
			"style": {
				"navigationBarTitleText": "家庭健康管理",
				"navigationBarBackgroundColor": "#FFF5F7"
			}
		},
		{
			"path": "pages/family/component/singlePage/memo-edit",
			"style": {
				"navigationBarTitleText": "编辑备忘录",
				"navigationBarBackgroundColor": "#FFF5F7"
			}
		}
	],
	"tabBar": {
		"color": "#BDBDBD",
		"selectedColor": "#FF5A79",
		"backgroundColor": "#ffffff",
		"borderStyle": "white",
		"fontSize": 16,
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "吃什么",
				"iconPath": "static/tabbar/home.png",
				"selectedIconPath": "static/tabbar/home-active.png"
			},
			{
				"pagePath": "pages/stock/stock",
				"text": "食材库存",
				"iconPath": "static/tabbar/stock.png",
				"selectedIconPath": "static/tabbar/stock-active.png"
			},
			{
				"pagePath": "pages/recipe/recipe",
				"text": "菜谱",
				"iconPath": "static/tabbar/recipe.png",
				"selectedIconPath": "static/tabbar/recipe-active.png"
			},
			{
				"pagePath": "pages/shop/shop",
				"text": "购物清单",
				"iconPath": "static/tabbar/shop.png",
				"selectedIconPath": "static/tabbar/shop-active.png"
			},
			{
				"pagePath": "pages/family/family",
				"text": "家庭",
				"iconPath": "static/tabbar/family.png",
				"selectedIconPath": "static/tabbar/family-active.png"
			}
		]
	},
	"globalStyle": {
		"navigationStyle": "custom",
		"navigationBarBackgroundColor": "#FFF5F7",
		"navigationBarTitleText": "家庭小厨房",
		"navigationBarTextStyle": "black",
		"backgroundColor": "#FAFAFA"
	}
}
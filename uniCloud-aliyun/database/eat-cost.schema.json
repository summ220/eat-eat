{
  "bsonType": "object",
  "required": ["price", "date"],
  "permission": {
    "read": true,
    "create": true,
    "update": true,
    "delete": true
  },
  "properties": {
    "_id": {
      "description": "存储箱ID，系统自动生成"
    },
    "name": {
      "bsonType": "string",
      "description": "备注/物品名称"
    },
    "price": {
      "bsonType": "double",
      "description": "金额"
    },
    "date": {
      "bsonType": "string",
      "description": "日期 yyyy-MM-dd"
    },
    "category": {
      "bsonType": "string",
      "description": "分类"
    },
    "create_time": {
      "bsonType": "timestamp",
      "description": "创建时间"
    }
  }
}
